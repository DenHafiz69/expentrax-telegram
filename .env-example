# --- Core bot configuration (local development) ---
BOT_TOKEN=xxxxx

# Optional: run in webhook mode instead of polling
WEBHOOK_URL=https://your-domain.example
SECRET_TOKEN=xxxxx

# --- Database configuration (optional; defaults to local SQLite) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/expentrax
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=expentrax
# DB_USER=postgres
# DB_PASSWORD=xxxxx

# --- AWS Lambda only (set automatically by Terraform) ---
# TELEGRAM_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:expentrax/telegram_bot_token
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:expentrax/db_credentials

# --- Observability ---
# METRICS_PORT=9090
