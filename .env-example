# --- Core bot configuration (local development) ---
BOT_TOKEN=xxxxx

# Optional: run in webhook mode instead of polling
WEBHOOK_URL=https://your-domain.example
SECRET_TOKEN=xxxxx

# --- Database configuration ---
# Turso / libSQL (used by the AWS Lambda deployment)
DB_URL=libsql://your-database-your-org.turso.io
DB_TOKEN=xxxxx

# Optional: generic SQLAlchemy URL or local PostgreSQL (docker-compose)
# DATABASE_URL=postgresql://user:password@localhost:5432/expentrax
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=expentrax
# DB_USER=postgres
# DB_PASSWORD=xxxxx

# --- AWS Lambda only (set automatically by Terraform) ---
# TELEGRAM_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:expentrax/telegram_bot_token

# --- Observability ---
# METRICS_PORT=9090
